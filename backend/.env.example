# SchemaSense AI - Backend Environment Configuration (Template)
# Copy this file to .env for local overrides

# Application
PROJECT_NAME="SchemaSense AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8001

# API Routing
API_PREFIX="/api"

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:4173", "http://127.0.0.1:4173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Database (Future Phase 2 persistence)
DATABASE_URL="sqlite:///./schemasense.db"

# AI Provider Settings (Inactive in Phase 1; configured for future phases)
ACTIVE_AI_PROVIDER="none"
AI_PROVIDER_API_KEY=""
